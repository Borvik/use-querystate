{
  "name": "@borvik/querystring",
  "version": "4.0.2",
  "description": "A library for parsing and encoding query string data",
  "author": "Chris Kolkman",
  "license": "MIT",
  "repository": "github:Borvik/use-querystate",
  "bugs": {
    "url": "https://github.com/Borvik/use-querystate/issues"
  },
  "main": "dist/cjs/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./dist/isEqual": {
      "import": {
        "types": "./dist/esm/isEqual.d.mts",
        "default": "./dist/esm/isEqual.js"
      },
      "require": {
        "types": "./dist/cjs/isEqual.d.cts",
        "default": "./dist/cjs/isEqual.cjs"
      }
    }
  },
  "scripts": {
    "build": "rimraf dist && duel -d",
    "test": "jest"
  },
  "dependencies": {
    "lodash": "~4.18.1"
  },
  "devDependencies": {
    "@knighted/duel": "4.1.1",
    "@types/jest": "~29.5.14",
    "@types/lodash": "4.14.168",
    "jest": "~29.7.0",
    "rimraf": "~3.0.2",
    "ts-jest": "~29.4.14",
    "typescript": "^6.0.3",
    "@types/node": "~22.9.0"
  }
}
